// Эти процедуры выполняются на сервере 1С.
// Аргументы с ключами заполняет ваша конфигурация из защищенного хранилища.

Функция ПримерЯндекс(КлючAPI, Каталог, Модель = "aliceai-llm/latest") Экспорт
	Настройки = ИнтеграцияИИ.НовыеНастройки("Яндекс");
	Настройки.КлючAPI = КлючAPI;
	Настройки.КаталогЯндекс = Каталог;
	Настройки.Модель = Модель; // Либо yandexgpt-5.1/latest.
	Ответ = ИнтеграцияИИ.СгенерироватьТекст(Настройки,
		"Объясни назначение общего модуля 1С.", "Отвечай кратко по-русски.");
	Возврат Ответ.Текст;
КонецФункции

Функция ПримерGigaChat(КлючАвторизации, Модель = "GigaChat-2") Экспорт
	Настройки = ИнтеграцияИИ.НовыеНастройки("GigaChat");
	Настройки.КлючАвторизации = КлючАвторизации;
	// Можно задать GigaChat-2-Pro, GigaChat-2-Max или GigaChat-3-Ultra,
	// если модель доступна для вашего аккаунта: ПолучитьМодели(Настройки).
	Настройки.Модель = Модель;
	Ответ = ИнтеграцияИИ.СгенерироватьТекст(Настройки, "Привет! Как дела?");
	// При следующих вызовах с той же структурой используется кэш токена.
	Возврат Ответ.Текст;
КонецФункции

Функция ПримерСовместимыйAPI(Провайдер, КлючAPI, Модель) Экспорт
	Настройки = ИнтеграцияИИ.НовыеНастройки(Провайдер);
	// Провайдер: OpenRouter, VseGPT или BotHub.
	Настройки.КлючAPI = КлючAPI;
	Настройки.Модель = Модель; // Точный идентификатор из каталога провайдера.
	История = Новый Массив;
	История.Добавить(ИнтеграцияИИ.НовоеСообщение("system", "Ты помощник по 1С."));
	История.Добавить(ИнтеграцияИИ.НовоеСообщение("user", "Что такое регистр накопления?"));
	ПервыйОтвет = ИнтеграцияИИ.ОтправитьСообщения(Настройки, История);
	История.Добавить(ИнтеграцияИИ.НовоеСообщение("assistant", ПервыйОтвет.Текст));
	История.Добавить(ИнтеграцияИИ.НовоеСообщение("user", "Приведи пример использования."));
	Возврат ИнтеграцияИИ.ОтправитьСообщения(Настройки, История);
КонецФункции

Функция ПримерСписокМоделейGigaChat(КлючАвторизации) Экспорт
	Настройки = ИнтеграцияИИ.НовыеНастройки("GigaChat");
	Настройки.КлючАвторизации = КлючАвторизации;
	Возврат ИнтеграцияИИ.ПолучитьМодели(Настройки);
КонецФункции
