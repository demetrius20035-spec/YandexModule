// Код для серверной процедуры вашей конфигурации. НастройкиМодели получает
// вызывающий код из защищенного хранилища. На клиент передаются только статус и текст.

Функция ЗадатьВопросПоДанным(НастройкиМодели, Вопрос) Экспорт
	Параметры = ПомощникИИ.НовыеПараметрыПомощника();
	// Для воспроизводимых тестов можно явно установить календарную дату сеанса:
	// Параметры.ДатаКонтекста = Дата(2026, 10, 6);
	Результат = ПомощникИИ.ОтветитьНаВопрос(НастройкиМодели, Вопрос, Параметры);
	Возврат Новый Структура("Статус,Текст", Результат.Статус, Результат.Текст);
КонецФункции

Функция ИзучитьСтруктуруДанных() Экспорт
	// Нет привязки к конкретному названию справочника клиентов или денежного регистра.
	Возврат КонтекстДанныхИИ.ПолучитьКаталогМетаданных("", 0, 100);
КонецФункции

Функция ПодготовитьСКДИзФакта(Факт) Экспорт
	// Факт берется из Результат.Факты после успешного запроса помощника.
	// Схема не содержит настроек вывода. Параметры нужно установить в настройках
	// компоновки вашей формы/отчета, сохранив пользовательский контекст выполнения.
	Схема = КонтекстДанныхИИ.СоздатьСхемуСКД(Факт.query, 100, Факт.parameters);
	ПараметрыЗапроса = КонтекстДанныхИИ.ПреобразоватьПараметры(Факт.parameters);
	Возврат Новый Структура("Схема,Параметры", Схема, ПараметрыЗапроса);
КонецФункции
