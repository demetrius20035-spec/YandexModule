// Общий модуль ИнтеграцияИИ: Сервер = Истина, Вызов сервера = Ложь,
// Клиент = Ложь, Глобальный = Ложь, Привилегированный = Ложь.
// Секреты передаются вызывающим серверным кодом и не записываются в журнал.

#Область ПубличныйИнтерфейс

// Провайдер: Яндекс, GigaChat, OpenRouter, VseGPT, BotHub, OpenAI.
// Для OpenAI требуется явно задать БазовыйURL и Модель.
Функция НовыеНастройки(Провайдер) Экспорт
	Настройки = Новый Структура;
	Настройки.Вставить("Провайдер", Провайдер);
	Настройки.Вставить("КлючAPI", "");
	Настройки.Вставить("КаталогЯндекс", "");
	Настройки.Вставить("КлючАвторизации", "");
	Настройки.Вставить("ТокенДоступа", "");
	Настройки.Вставить("СрокДействияТокена", 0); // expires_at: миллисекунды Unix UTC.
	Настройки.Вставить("Scope", "GIGACHAT_API_PERS");
	Настройки.Вставить("URLАвторизации", "https://ngw.devices.sberbank.ru:9443/api/v2/oauth");
	Настройки.Вставить("БазовыйURL", "");
	Настройки.Вставить("Модель", "");
	Настройки.Вставить("Таймаут", 60);
	Настройки.Вставить("ФайлСертификатовУЦ", ""); // Дополнительный PEM bundle доверенных УЦ.
	Настройки.Вставить("Температура", 0.3);
	Настройки.Вставить("МаксимумТокенов", 1500);
	Настройки.Вставить("ПроверятьНенормативнуюЛексику", Истина);
	Настройки.Вставить("HTTPReferer", "");
	Настройки.Вставить("НазваниеПриложения", "");
	Если Провайдер = "Яндекс" Тогда
		Настройки.БазовыйURL = "https://ai.api.cloud.yandex.net/v1";
		Настройки.Модель = "yandexgpt-5.1/latest";
	ИначеЕсли Провайдер = "GigaChat" Тогда
		Настройки.БазовыйURL = "https://api.giga.chat/v1";
		Настройки.Модель = "GigaChat-2";
	ИначеЕсли Провайдер = "OpenRouter" Тогда
		Настройки.БазовыйURL = "https://openrouter.ai/api/v1";
	ИначеЕсли Провайдер = "VseGPT" Тогда
		Настройки.БазовыйURL = "https://api.vsegpt.ru/v1";
	ИначеЕсли Провайдер = "BotHub" Тогда
		Настройки.БазовыйURL = "https://api.bothub.chat/v1/openai";
	ИначеЕсли Провайдер <> "OpenAI" Тогда
		ВызватьИсключение "ИИ: неизвестный провайдер.";
	КонецЕсли;
	Возврат Настройки;
КонецФункции

// Сообщения — массив структур с полями role и content (строки).
Функция НовоеСообщение(Роль, Текст) Экспорт
	Если Роль <> "system" И Роль <> "user" И Роль <> "assistant" Тогда
		ВызватьИсключение "ИИ: допустимые роли: system, user, assistant.";
	КонецЕсли;
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		ВызватьИсключение "ИИ: содержимое сообщения должно быть строкой.";
	КонецЕсли;
	Возврат Новый Структура("role,content", Роль, Текст);
КонецФункции

// Упрощенный вызов без истории. Возвращает структуру Текст, Модель, Данные.
Функция СгенерироватьТекст(Настройки, Запрос, Инструкция = "") Экспорт
	Сообщения = Новый Массив;
	Если Не ПустаяСтрока(Инструкция) Тогда
		Сообщения.Добавить(НовоеСообщение("system", Инструкция));
	КонецЕсли;
	Сообщения.Добавить(НовоеСообщение("user", Запрос));
	Возврат ОтправитьСообщения(Настройки, Сообщения);
КонецФункции

// Настройки GigaChat изменяются: сохраняются токен и срок его действия.
// Храните структуру в серверном контексте; не разделяйте ее между пользователями.
Функция ОтправитьСообщения(Настройки, Сообщения) Экспорт
	ПроверитьНастройки(Настройки);
	ПроверитьСообщения(Сообщения);
	Заголовки = НовыеЗаголовки();
	Если Настройки.Провайдер = "Яндекс" Тогда
		Тело = ТелоЗапросаЯндекс(Настройки, Сообщения);
		Путь = "/responses";
		Заголовки.Вставить("Authorization", "Bearer " + Настройки.КлючAPI);
		Заголовки.Вставить("OpenAI-Project", Настройки.КаталогЯндекс);
	Иначе
		Тело = ТелоЗапросаЧата(Настройки, Сообщения);
		Путь = "/chat/completions";
		Если Настройки.Провайдер = "GigaChat" Тогда
			Токен = ПолучитьТокенGigaChat(Настройки);
		Иначе
			Токен = Настройки.КлючAPI;
		КонецЕсли;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		Если Настройки.Провайдер = "OpenRouter" Тогда
			Если Не ПустаяСтрока(Настройки.HTTPReferer) Тогда
				ТребоватьСтроку(Настройки.HTTPReferer, "HTTPReferer");
				Заголовки.Вставить("HTTP-Referer", Настройки.HTTPReferer);
			КонецЕсли;
			Если Не ПустаяСтрока(Настройки.НазваниеПриложения) Тогда
				ТребоватьСтроку(Настройки.НазваниеПриложения, "НазваниеПриложения");
				Заголовки.Вставить("X-Title", Настройки.НазваниеПриложения);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ОтветHTTP = ВыполнитьHTTP(Настройки.БазовыйURL + Путь, Заголовки,
		СтрокаJSON(Тело), Настройки.Таймаут, "POST", Настройки.ФайлСертификатовУЦ);
	// Повторяем только запрос с отклоненным токеном и только один раз.
	Если Настройки.Провайдер = "GigaChat" И ОтветHTTP.КодСостояния = 401
		И Не ПустаяСтрока(Настройки.КлючАвторизации) Тогда
		Токен = ПолучитьТокенGigaChat(Настройки, Истина);
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		ОтветHTTP = ВыполнитьHTTP(Настройки.БазовыйURL + Путь, Заголовки,
			СтрокаJSON(Тело), Настройки.Таймаут, "POST", Настройки.ФайлСертификатовУЦ);
	КонецЕсли;
	Данные = ДанныеОтвета(ОтветHTTP);
	Если Настройки.Провайдер = "Яндекс" Тогда
		Текст = ТекстОтветаЯндекс(Данные);
	Иначе
		Текст = ТекстОтветаЧата(Данные);
	КонецЕсли;
	Возврат Новый Структура("Текст,Модель,Данные", Текст,
		Поле(Данные, "model", Настройки.Модель), Данные);
КонецФункции

// Можно использовать готовый Bearer-токен либо Basic-ключ из личного кабинета.
// КлючАвторизации — уже готовая base64-строка, без префикса Basic.
Функция ПолучитьТокенGigaChat(Настройки, Обновить = Ложь) Экспорт
	Если Настройки.Провайдер <> "GigaChat" Тогда
		ВызватьИсключение "ИИ: получение токена доступно только для GigaChat.";
	КонецЕсли;
	Если Не Обновить И Не ПустаяСтрока(Настройки.ТокенДоступа) Тогда
		Если Настройки.СрокДействияТокена = 0
			Или Настройки.СрокДействияТокена > МиллисекундыUnix() + 60000 Тогда
			ТребоватьСтроку(Настройки.ТокенДоступа, "ТокенДоступа");
			Возврат Настройки.ТокенДоступа;
		КонецЕсли;
	КонецЕсли;
	ТребоватьСтроку(Настройки.КлючАвторизации, "КлючАвторизации");
	Если Настройки.Scope <> "GIGACHAT_API_PERS"
		И Настройки.Scope <> "GIGACHAT_API_B2B"
		И Настройки.Scope <> "GIGACHAT_API_CORP" Тогда
		ВызватьИсключение "ИИ: неизвестный scope GigaChat.";
	КонецЕсли;
	Заголовки = НовыеЗаголовки();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("RqUID", Строка(Новый УникальныйИдентификатор));
	Заголовки.Вставить("Authorization", "Basic " + Настройки.КлючАвторизации);
	ОтветHTTP = ВыполнитьHTTP(Настройки.URLАвторизации, Заголовки,
		"scope=" + Настройки.Scope, Настройки.Таймаут, "POST", Настройки.ФайлСертификатовУЦ);
	Данные = ДанныеОтвета(ОтветHTTP);
	Токен = Поле(Данные, "access_token", "");
	Срок = Поле(Данные, "expires_at", 0);
	ТребоватьСтроку(Токен, "access_token в ответе OAuth");
	Если ТипЗнч(Срок) <> Тип("Число") Или Срок <= МиллисекундыUnix() Тогда
		ВызватьИсключение "ИИ: OAuth вернул некорректный expires_at.";
	КонецЕсли;
	Настройки.ТокенДоступа = Токен;
	Настройки.СрокДействияТокена = Срок;
	Возврат Токен;
КонецФункции

// Возвращает массив data из API /models. Для Яндекс задавайте URI модели явно.
Функция ПолучитьМодели(Настройки) Экспорт
	Если Настройки.Провайдер = "Яндекс" Тогда
		ВызватьИсключение "ИИ: для Яндекс укажите модель из каталога провайдера.";
	КонецЕсли;
	ПроверитьНастройки(Настройки, Ложь);
	Заголовки = НовыеЗаголовки();
	Если Настройки.Провайдер = "GigaChat" Тогда
		Токен = ПолучитьТокенGigaChat(Настройки);
	Иначе
		Токен = Настройки.КлючAPI;
	КонецЕсли;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	ОтветHTTP = ВыполнитьHTTP(Настройки.БазовыйURL + "/models", Заголовки,
		"", Настройки.Таймаут, "GET", Настройки.ФайлСертификатовУЦ);
	Если Настройки.Провайдер = "GigaChat" И ОтветHTTP.КодСостояния = 401
		И Не ПустаяСтрока(Настройки.КлючАвторизации) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + ПолучитьТокенGigaChat(Настройки, Истина));
		ОтветHTTP = ВыполнитьHTTP(Настройки.БазовыйURL + "/models", Заголовки,
			"", Настройки.Таймаут, "GET", Настройки.ФайлСертификатовУЦ);
	КонецЕсли;
	Данные = ДанныеОтвета(ОтветHTTP);
	Модели = Поле(Данные, "data");
	Если ТипЗнч(Модели) <> Тип("Массив") Тогда
		ВызватьИсключение "ИИ: API не вернул массив моделей data.";
	КонецЕсли;
	Возврат Модели;
КонецФункции

#КонецОбласти

#Область ПодготовкаЗапросов

Процедура ПроверитьНастройки(Настройки, НужнаМодель = Истина)
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		ВызватьИсключение "ИИ: настройки должны быть структурой из НовыеНастройки().";
	КонецЕсли;
	Провайдер = Поле(Настройки, "Провайдер", "");
	Если Провайдер <> "Яндекс" И Провайдер <> "GigaChat" И Провайдер <> "OpenRouter"
		И Провайдер <> "VseGPT" И Провайдер <> "BotHub" И Провайдер <> "OpenAI" Тогда
		ВызватьИсключение "ИИ: неизвестный провайдер.";
	КонецЕсли;
	ТребоватьСтроку(Настройки.БазовыйURL, "БазовыйURL");
	// Не допускаем двойной слеш при добавлении пути API.
	Если Прав(Настройки.БазовыйURL, 1) = "/" Тогда
		ВызватьИсключение "ИИ: БазовыйURL указывается без завершающего слеша.";
	КонецЕсли;
	Если НужнаМодель Тогда
		ТребоватьСтроку(Настройки.Модель, "Модель");
	КонецЕсли;
	Если ТипЗнч(Настройки.Таймаут) <> Тип("Число") Или Настройки.Таймаут <= 0 Тогда
		ВызватьИсключение "ИИ: Таймаут должен быть положительным числом секунд.";
	КонецЕсли;
	Если НужнаМодель Тогда
		Если ТипЗнч(Настройки.Температура) <> Тип("Число")
			Или Настройки.Температура < 0 Или Настройки.Температура > 2 Тогда
			ВызватьИсключение "ИИ: Температура должна быть числом от 0 до 2; учитывайте ограничения модели.";
		КонецЕсли;
		Если ТипЗнч(Настройки.МаксимумТокенов) <> Тип("Число")
			Или Настройки.МаксимумТокенов <= 0
			Или Цел(Настройки.МаксимумТокенов) <> Настройки.МаксимумТокенов Тогда
			ВызватьИсключение "ИИ: МаксимумТокенов должен быть положительным целым числом.";
		КонецЕсли;
	КонецЕсли;
	Если Провайдер = "Яндекс" Тогда
		ТребоватьСтроку(Настройки.КаталогЯндекс, "КаталогЯндекс");
	КонецЕсли;
	Если Провайдер <> "GigaChat" Тогда
		ТребоватьСтроку(Настройки.КлючAPI, "КлючAPI");
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСообщения(Сообщения)
	Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		ВызватьИсключение "ИИ: сообщения должны быть массивом.";
	КонецЕсли;
	Если Сообщения.Количество() = 0 Тогда
		ВызватьИсключение "ИИ: нужен хотя бы один запрос пользователя.";
	КонецЕсли;
	ЕстьПользователь = Ложь;
	Для Каждого Сообщение Из Сообщения Цикл
		Роль = Поле(Сообщение, "role", "");
		Текст = Поле(Сообщение, "content");
		НовоеСообщение(Роль, Текст);
		Если Роль = "user" И Не ПустаяСтрока(Текст) Тогда
			ЕстьПользователь = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьПользователь Тогда
		ВызватьИсключение "ИИ: нужен непустой запрос пользователя.";
	КонецЕсли;
КонецПроцедуры

Функция ТелоЗапросаЯндекс(Настройки, Сообщения)
	Модель = Настройки.Модель;
	Если Лев(Модель, 6) <> "gpt://" Тогда
		Модель = "gpt://" + Настройки.КаталогЯндекс + "/" + Модель;
	КонецЕсли;
	Инструкции = "";
	Вход = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Если Сообщение.role = "system" Тогда
			Если Не ПустаяСтрока(Инструкции) Тогда
				Инструкции = Инструкции + Символы.ПС;
			КонецЕсли;
			Инструкции = Инструкции + Сообщение.content;
		Иначе
			Вход.Добавить(Новый Структура("role,content", Сообщение.role, Сообщение.content));
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("model,temperature,instructions,input,max_output_tokens,stream",
		Модель, Настройки.Температура, Инструкции, Вход, Настройки.МаксимумТокенов, Ложь);
КонецФункции

Функция ТелоЗапросаЧата(Настройки, Сообщения)
	ЧистыеСообщения = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		ЧистыеСообщения.Добавить(НовоеСообщение(Сообщение.role, Сообщение.content));
	КонецЦикла;
	Тело = Новый Структура("model,messages,temperature,max_tokens,stream",
		Настройки.Модель, ЧистыеСообщения, Настройки.Температура, Настройки.МаксимумТокенов, Ложь);
	Если Настройки.Провайдер = "GigaChat" Тогда
		Тело.Вставить("profanity_check", Настройки.ПроверятьНенормативнуюЛексику);
	КонецЕсли;
	Возврат Тело;
КонецФункции

#КонецОбласти

#Область ТранспортИОтветы

Функция НовыеЗаголовки()
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Accept", "application/json");
	Возврат Заголовки;
КонецФункции

// Разбираем только HTTPS URL без учетных данных, query и fragment.
Функция РазобратьURL(URL)
	ТребоватьСтроку(URL, "URL");
	Если Лев(URL, 8) <> "https://" Тогда
		ВызватьИсключение "ИИ: разрешен только HTTPS.";
	КонецЕсли;
	Остаток = Сред(URL, 9);
	Позиция = СтрНайти(Остаток, "/");
	Если Позиция = 0 Тогда
		Адрес = Остаток;
		Путь = "/";
	Иначе
		Адрес = Лев(Остаток, Позиция - 1);
		Путь = Сред(Остаток, Позиция);
	КонецЕсли;
	Если ПустаяСтрока(Адрес) Или СтрНайти(URL, "@") > 0
		Или СтрНайти(URL, "?") > 0 Или СтрНайти(URL, "#") > 0
		Или СтрНайти(URL, " ") > 0 Или СтрНайти(URL, Символы.ПС) > 0
		Или СтрНайти(URL, Символы.ВК) > 0 Тогда
		ВызватьИсключение "ИИ: некорректный URL API.";
	КонецЕсли;
	Части = СтрРазделить(Адрес, ":", Истина);
	Если Части.Количество() > 2 Тогда
		ВызватьИсключение "ИИ: используйте DNS-имя сервера, IPv6 URL не поддерживается.";
	КонецЕсли;
	Порт = 443;
	Если Части.Количество() = 2 Тогда
		Попытка
			Порт = Число(Части[1]);
		Исключение
			ВызватьИсключение "ИИ: некорректный порт API.";
		КонецПопытки;
		Если Порт < 1 Или Порт > 65535 Или Цел(Порт) <> Порт Тогда
			ВызватьИсключение "ИИ: некорректный порт API.";
		КонецЕсли;
	КонецЕсли;
	ТребоватьСтроку(Части[0], "Сервер API");
	Возврат Новый Структура("Сервер,Порт,Путь", Части[0], Порт, Путь);
КонецФункции

Функция ВыполнитьHTTP(URL, Заголовки, Тело, Таймаут, Метод = "POST", ФайлСертификатовУЦ = "")
	Адрес = РазобратьURL(URL);
	// Проверка сертификата обязательна. Используется хранилище доверия платформы.
	Если ПустаяСтрока(ФайлСертификатовУЦ) Тогда
		TLS = Новый ЗащищенноеСоединениеOpenSSL;
	Иначе
		СертификатыУЦ = Новый СертификатыУдостоверяющихЦентровФайл(ФайлСертификатовУЦ);
		TLS = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, СертификатыУЦ);
	КонецЕсли;
	Соединение = Новый HTTPСоединение(Адрес.Сервер, Адрес.Порт, , , , Таймаут, TLS);
	ЗапросHTTP = Новый HTTPЗапрос(Адрес.Путь, Заголовки);
	Если Метод = "POST" Тогда
		ЗапросHTTP.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8,
			ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	Попытка
		Возврат Соединение.ВызватьHTTPМетод(Метод, ЗапросHTTP);
	Исключение
		// Не передаем ОписаниеОшибки(): оно может содержать секреты/данные запроса.
		ВызватьИсключение "ИИ: ошибка HTTPS. Проверьте доступ сервера, доверенные сертификаты и таймаут.";
	КонецПопытки;
КонецФункции

Функция СтрокаJSON(Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция ДанныеОтвета(ОтветHTTP)
	Код = ОтветHTTP.КодСостояния;
	Если Код < 200 Или Код >= 300 Тогда
		// Тело ошибки не включаем в исключение: провайдер может отразить запрос/ключ.
		Если Код = 401 Или Код = 403 Тогда
			Причина = "проверьте ключ, scope и права доступа";
		ИначеЕсли Код = 429 Тогда
			Причина = "лимит запросов или квота; повторите позже";
		ИначеЕсли Код >= 500 Тогда
			Причина = "ошибка сервиса; повторите позже";
		Иначе
			Причина = "проверьте URL, модель и параметры запроса";
		КонецЕсли;
		ВызватьИсключение "ИИ: HTTP " + Формат(Код, "ЧГ=0") + "; " + Причина + ".";
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Попытка
		Чтение.УстановитьСтроку(ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
		Данные = ПрочитатьJSON(Чтение);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение "ИИ: сервис вернул некорректный JSON.";
	КонецПопытки;
	Чтение.Закрыть();
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ВызватьИсключение "ИИ: ожидается JSON-объект ответа.";
	КонецЕсли;
	Если Поле(Данные, "error") <> Неопределено Тогда
		ВызватьИсключение "ИИ: сервис вернул ошибку в JSON-ответе.";
	КонецЕсли;
	Возврат Данные;
КонецФункции

Функция ТекстОтветаЯндекс(Данные)
	// output_text — свойство SDK, в REST текст обычно находится внутри output[].content[].
	Статус = Поле(Данные, "status", "completed");
	Если Статус <> "completed" И Статус <> "incomplete" Тогда
		ВызватьИсключение "ИИ: генерация Responses API не завершена успешно.";
	КонецЕсли;
	Текст = Поле(Данные, "output_text");
	Если ТипЗнч(Текст) = Тип("Строка") И Не ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Выход = Поле(Данные, "output");
	Если ТипЗнч(Выход) <> Тип("Массив") Тогда
		ВызватьИсключение "ИИ: в ответе Responses API отсутствует output.";
	КонецЕсли;
	Текст = "";
	Для Каждого Элемент Из Выход Цикл
		Содержимое = Поле(Элемент, "content");
		Если ТипЗнч(Содержимое) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Блок Из Содержимое Цикл
			Если Поле(Блок, "type", "") = "output_text" Тогда
				Фрагмент = Поле(Блок, "text", "");
				Если ТипЗнч(Фрагмент) = Тип("Строка") Тогда
					Текст = Текст + Фрагмент;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если ПустаяСтрока(Текст) Тогда
		ВызватьИсключение "ИИ: сервис не вернул текст (возможен отказ модели).";
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ТекстОтветаЧата(Данные)
	Варианты = Поле(Данные, "choices");
	Если ТипЗнч(Варианты) <> Тип("Массив") Тогда
		ВызватьИсключение "ИИ: в ответе Chat Completions отсутствует choices.";
	КонецЕсли;
	Если Варианты.Количество() = 0 Тогда
		ВызватьИсключение "ИИ: сервис вернул пустой choices.";
	КонецЕсли;
	Текст = Поле(Поле(Варианты[0], "message"), "content");
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		ВызватьИсключение "ИИ: сервис не вернул текст (возможен отказ или вызов инструмента).";
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда
		ВызватьИсключение "ИИ: сервис вернул пустой текст.";
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция Поле(Объект, Имя, ПоУмолчанию = Неопределено)
	Значение = Неопределено;
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Если Объект.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Процедура ТребоватьСтроку(Значение, Имя)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение "ИИ: требуется строка " + Имя + ".";
	КонецЕсли;
	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение "ИИ: не заполнено " + Имя + ".";
	КонецЕсли;
	Если СтрНайти(Значение, Символы.ПС) > 0 Или СтрНайти(Значение, Символы.ВК) > 0 Тогда
		ВызватьИсключение "ИИ: недопустимый перенос строки в " + Имя + ".";
	КонецЕсли;
КонецПроцедуры

Функция МиллисекундыUnix()
	Возврат (ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1)) * 1000;
КонецФункции

#КонецОбласти
