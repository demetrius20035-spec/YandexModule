// Серверный общий модуль. Глобальный, Вызов сервера, Привилегированный = Ложь.
// Все действия исполняются в текущем пользовательском контексте.
// Не является средством ограничения ресурсов СУБД: ПЕРВЫЕ ограничивает выдачу.

#Область Метаданные

// Постраничный каталог всех объектов данных с правом Чтение, без белого списка.
// Перечисления описываются как структура конфигурации, а не записи базы.
Функция ПолучитьКаталогМетаданных(Поиск = "", Смещение = 0, РазмерСтраницы = 100) Экспорт
	ПроверитьКонтекст();
	ПроверитьЦелое(Смещение, 0, 1000000, "Смещение");
	ПроверитьЦелое(РазмерСтраницы, 1, 200, "РазмерСтраницы");
	ПроверитьСтроку(Поиск, 200, "Поиск");
	Все = Новый Массив;
	ДобавитьКоллекцию(Все, Метаданные.Справочники, Поиск);
	ДобавитьКоллекцию(Все, Метаданные.Документы, Поиск);
	ДобавитьКоллекцию(Все, Метаданные.РегистрыСведений, Поиск);
	ДобавитьКоллекцию(Все, Метаданные.РегистрыНакопления, Поиск);
	ДобавитьКоллекцию(Все, Метаданные.РегистрыБухгалтерии, Поиск);
	ДобавитьКоллекцию(Все, Метаданные.РегистрыРасчета, Поиск);
	ДобавитьКоллекцию(Все, Метаданные.ПланыСчетов, Поиск);
	ДобавитьКоллекцию(Все, Метаданные.ПланыВидовХарактеристик, Поиск);
	ДобавитьКоллекцию(Все, Метаданные.ПланыВидовРасчета, Поиск);
	ДобавитьКоллекцию(Все, Метаданные.БизнесПроцессы, Поиск);
	ДобавитьКоллекцию(Все, Метаданные.Задачи, Поиск);
	ДобавитьКоллекцию(Все, Метаданные.Константы, Поиск);
	ДобавитьКоллекцию(Все, Метаданные.Перечисления, Поиск);
	Страница = Новый Массив;
	Индекс = Смещение;
	Пока Индекс < Все.Количество() И Страница.Количество() < РазмерСтраницы Цикл
		Страница.Добавить(Все[Индекс]);
		Индекс = Индекс + 1;
	КонецЦикла;
	Следующее = Неопределено;
	Если Индекс < Все.Количество() Тогда
		Следующее = Индекс;
	КонецЕсли;
	Возврат Новый Структура("objects,total,next_offset", Страница, Все.Количество(), Следующее);
КонецФункции

// Путь: Документ.Заказ, РегистрНакопления.ДенежныеСредства и т. п.
// Имена объектов не зашиты. Описываются реальные поля установленной конфигурации.
Функция ПолучитьОписаниеОбъекта(Путь, Смещение = 0, РазмерСтраницы = 50) Экспорт
	ПроверитьКонтекст();
	ПроверитьЦелое(Смещение, 0, 1000000, "Смещение");
	ПроверитьЦелое(РазмерСтраницы, 1, 100, "РазмерСтраницы");
	ОбъектМД = НайтиОбъектДанных(Путь);
	Описание = Новый Структура("path,synonym,fields,table_parts",
		Путь, ОбъектМД.Синоним, Новый Массив, Новый Массив);
	Категория = СтрРазделить(Путь, ".")[0];
	Если Категория = "Перечисление" Тогда
		Значения = Новый Массив;
		Для Каждого ЗначениеМД Из ОбъектМД.ЗначенияПеречисления Цикл
			Значения.Добавить(Новый Структура("name,synonym", ЗначениеМД.Имя, ЗначениеМД.Синоним));
		КонецЦикла;
		Описание.Вставить("values", Значения);
		Описание.Вставить("note", "Значения перечислений в запросе: ЗНАЧЕНИЕ(Перечисление.Имя.Значение).");
		Возврат СтраницаОписания(Описание, Смещение, РазмерСтраницы);
	ИначеЕсли Категория = "Константа" Тогда
		Описание.Вставить("query_source", "Константы");
		Описание.fields.Добавить(ОписаниеПоля(ОбъектМД.Имя, ОбъектМД.Синоним, ОбъектМД.Тип));
		Возврат СтраницаОписания(Описание, Смещение, РазмерСтраницы);
	КонецЕсли;
	ДобавитьПоля(Описание.fields, ОбъектМД.СтандартныеРеквизиты);
	ДобавитьПоля(Описание.fields, ОбъектМД.Реквизиты);
	Если Лев(Категория, 7) = "Регистр" Тогда
		ДобавитьПоля(Описание.fields, ОбъектМД.Измерения);
		ДобавитьПоля(Описание.fields, ОбъектМД.Ресурсы);
		// Реквизиты виртуальных таблиц отличаются от полей основной таблицы.
		Описание.Вставить("note", "Для виртуальных таблиц используйте синтаксис платформы; поля ниже относятся к основной таблице.");
	Иначе
		Для Каждого ТабличнаяЧасть Из ОбъектМД.ТабличныеЧасти Цикл
			Поля = Новый Массив;
			ДобавитьПоля(Поля, ТабличнаяЧасть.СтандартныеРеквизиты);
			ДобавитьПоля(Поля, ТабличнаяЧасть.Реквизиты);
			Описание.table_parts.Добавить(Новый Структура("name,synonym,fields",
				ТабличнаяЧасть.Имя, ТабличнаяЧасть.Синоним, Поля));
		КонецЦикла;
	КонецЕсли;
	Возврат СтраницаОписания(Описание, Смещение, РазмерСтраницы);
КонецФункции

// Сквозная пагинация по реквизитам объекта, табличных частей или значениям перечисления.
Функция СтраницаОписания(Описание, Смещение, Размер)
	Счетчик = 0;
	Описание.fields = СтраницаЭлементов(Описание.fields, Смещение, Размер, Счетчик);
	Для Каждого ТабличнаяЧасть Из Описание.table_parts Цикл
		ТабличнаяЧасть.fields = СтраницаЭлементов(ТабличнаяЧасть.fields, Смещение, Размер, Счетчик);
	КонецЦикла;
	Если Описание.Свойство("values") Тогда
		Описание.values = СтраницаЭлементов(Описание.values, Смещение, Размер, Счетчик);
	КонецЕсли;
	Следующее = Неопределено;
	Если Смещение + Размер < Счетчик Тогда
		Следующее = Смещение + Размер;
	КонецЕсли;
	Описание.Вставить("total_fields", Счетчик);
	Описание.Вставить("next_offset", Следующее);
	Возврат Описание;
КонецФункции

Функция СтраницаЭлементов(Элементы, Смещение, Размер, Счетчик)
	Результат = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Если Счетчик >= Смещение И Счетчик < Смещение + Размер Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
		Счетчик = Счетчик + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ДобавитьКоллекцию(Результат, Коллекция, Поиск)
	Для Каждого ОбъектМД Из Коллекция Цикл
		Путь = ОбъектМД.ПолноеИмя();
		Если Не ДоступенОбъект(ОбъектМД) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(Поиск) И СтрНайти(ВРег(Путь + " " + ОбъектМД.Синоним), ВРег(Поиск)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("path,synonym", Путь, ОбъектМД.Синоним));
	КонецЦикла;
КонецПроцедуры

Функция ДоступенОбъект(ОбъектМД)
	Если Лев(ОбъектМД.ПолноеИмя(), 13) = "Перечисление." Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ПравоДоступа("Чтение", ОбъектМД);
КонецФункции

Функция НайтиОбъектДанных(Путь)
	ПроверитьСтроку(Путь, 300, "Путь");
	Части = СтрРазделить(Путь, ".", Истина);
	Если Части.Количество() <> 2 Тогда
		ВызватьИсключение "ИИ: нужен путь объекта данных вида Документ.Имя.";
	КонецЕсли;
	Категории = ",Справочник,Документ,РегистрСведений,РегистрНакопления,РегистрБухгалтерии,РегистрРасчета,ПланСчетов,ПланВидовХарактеристик,ПланВидовРасчета,БизнесПроцесс,Задача,Константа,Перечисление,";
	Если СтрНайти(Категории, "," + Части[0] + ",") = 0 Тогда
		ВызватьИсключение "ИИ: указанная категория метаданных не является объектом данных.";
	КонецЕсли;
	ОбъектМД = Метаданные.НайтиПоПолномуИмени(Путь);
	Если ОбъектМД = Неопределено Тогда
		ВызватьИсключение "ИИ: объект метаданных не найден.";
	КонецЕсли;
	Если Не ДоступенОбъект(ОбъектМД) Тогда
		ВызватьИсключение "ИИ: нет права чтения объекта.";
	КонецЕсли;
	Возврат ОбъектМД;
КонецФункции

Процедура ДобавитьПоля(Результат, Коллекция)
	Для Каждого ПолеМД Из Коллекция Цикл
		Результат.Добавить(ОписаниеПоля(ПолеМД.Имя, ПолеМД.Синоним, ПолеМД.Тип));
	КонецЦикла;
КонецПроцедуры

Функция ОписаниеПоля(Имя, Синоним, ОписаниеТипа)
	Ссылки = Новый Массив;
	Для Каждого ТипПоля Из ОписаниеТипа.Типы() Цикл
		СвязанныйОбъект = Метаданные.НайтиПоТипу(ТипПоля);
		Если СвязанныйОбъект <> Неопределено Тогда
			Если ДоступенОбъект(СвязанныйОбъект) Тогда
				Ссылки.Добавить(СвязанныйОбъект.ПолноеИмя());
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("name,synonym,type,references", Имя, Синоним, Строка(ОписаниеТипа), Ссылки);
КонецФункции

#КонецОбласти

#Область ЗапросыИСКД

// Параметры: массив {name, type, value}; type: string, number, boolean, date.
// Дата: YYYY-MM-DD или YYYY-MM-DDTHH:MM:SS, календарное время сеанса 1С.
// Не исполняет BSL, не использует привилегированный режим.
Функция ВыполнитьЗапрос(ТекстЗапроса, Параметры = Неопределено, МаксимумСтрок = 100,
	МаксимумСимволов = 30000) Экспорт
	ПроверитьКонтекст();
	ПроверитьЦелое(МаксимумСимволов, 1000, 100000, "МаксимумСимволов");
	Подготовленный = ПодготовитьЗапрос(ТекстЗапроса, МаксимумСтрок);
	Запрос = Новый Запрос(Подготовленный);
	Значения = ПреобразоватьПараметры(Параметры);
	Для Каждого Параметр Из Значения Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	// Ограничения прав/RLS обеспечивает движок запросов 1С.
	// Не оборачиваем выполнение в привилегированный режим и не заменяем учетную запись.
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Колонки.Количество() > 50 Тогда
		ВызватьИсключение "ИИ: запрос вернул больше 50 колонок; выберите необходимые поля.";
	КонецЕсли;
	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Новый Структура("name,type", Колонка.Имя, Строка(Колонка.ТипЗначения)));
	КонецЦикла;
	Строки = Новый Массив;
	Обрезано = Ложь;
	Длина = СтрДлина(JSON(Колонки));
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Строки.Количество() >= МаксимумСтрок Тогда
			Обрезано = Истина;
			Прервать;
		КонецЕсли;
		СтрокаДанных = Новый Массив;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			СтрокаДанных.Добавить(ЗначениеДляJSON(Выборка[Колонка.Имя]));
		КонецЦикла;
		Длина = Длина + СтрДлина(JSON(СтрокаДанных));
		Если Длина > МаксимумСимволов Тогда
			Обрезано = Истина;
			Прервать;
		КонецЕсли;
		Строки.Добавить(СтрокаДанных);
	КонецЦикла;
	Возврат Новый Структура("query,columns,rows,truncated,access_scope",
		Подготовленный, Колонки, Строки, Обрезано, "Только данные, доступные текущему пользователю. Применено РАЗРЕШЕННЫЕ.");
КонецФункции

// Формирует только схему с набором-запросом. Настройки группировок, ресурсов,
// выбор параметров и вывод отчета задает вызывающая конфигурация.
Функция СоздатьСхемуСКД(ТекстЗапроса, МаксимумСтрок = 100, Параметры = Неопределено) Экспорт
	ПроверитьКонтекст();
	Подготовленный = ПодготовитьЗапрос(ТекстЗапроса, МаксимумСтрок, Ложь);
	Схема = Новый СхемаКомпоновкиДанных;
	Источник = Схема.ИсточникиДанных.Добавить();
	Источник.Имя = "ИсточникДанных";
	Источник.ТипИсточникаДанных = "Local";
	Набор = Схема.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	Набор.Имя = "ДанныеИИ";
	Набор.ИсточникДанных = Источник.Имя;
	Набор.Запрос = Подготовленный;
	Набор.АвтоЗаполнениеДоступныхПолей = Истина;
	Значения = ПреобразоватьПараметры(Параметры);
	Для Каждого Параметр Из Значения Цикл
		ПараметрСхемы = Схема.Параметры.Добавить();
		ПараметрСхемы.Имя = Параметр.Ключ;
		ПараметрСхемы.ТипЗначения = Новый ОписаниеТипов(Строка(ТипЗнч(Параметр.Значение)));
		ПараметрСхемы.Значение = Параметр.Значение;
	КонецЦикла;
	Возврат Схема;
КонецФункции

// Проверка формы запроса, не замена синтаксическому анализатору платформы.
// Один SELECT; без пакетов, временных таблиц, UNION, итогов и блокировок.
// Ограничение выдачи ставится до выполнения, а не только при сериализации.
Функция ПодготовитьЗапрос(ТекстЗапроса, МаксимумСтрок = 100, ЗапасСтроки = Истина) Экспорт
	ПроверитьСтроку(ТекстЗапроса, 20000, "ТекстЗапроса");
	ПроверитьЦелое(МаксимумСтрок, 1, 1000, "МаксимумСтрок");
	Токены = ТокеныЗапроса(ТекстЗапроса);
	Если Токены.Количество() < 2 Тогда
		ВызватьИсключение "ИИ: нужен непустой запрос ВЫБРАТЬ.";
	КонецЕсли;
	Если Токены[0].kind <> "word" Или (Токены[0].text <> "ВЫБРАТЬ" И Токены[0].text <> "SELECT") Тогда
		ВызватьИсключение "ИИ: разрешен только запрос ВЫБРАТЬ.";
	КонецЕсли;
	Запрещены = ",ПОМЕСТИТЬ,INTO,УНИЧТОЖИТЬ,DROP,ОБЪЕДИНИТЬ,UNION,ИТОГИ,TOTALS,ИЗМЕНЕНИЯ,UPDATE,";
	Для Каждого Токен Из Токены Цикл
		Если Токен.text = ";" И Токен.kind = "symbol" Тогда
			ВызватьИсключение "ИИ: пакеты запросов и точка с запятой не поддерживаются.";
		КонецЕсли;
		Если Токен.kind = "word" И СтрНайти(Запрещены, "," + Токен.text + ",") > 0 Тогда
			ВызватьИсключение "ИИ: временные таблицы, объединения, итоги и блокировки не поддерживаются.";
		КонецЕсли;
	КонецЦикла;
	Индекс = 1;
	Различные = Ложь;
	Лимит = МаксимумСтрок;
	Если ЗапасСтроки Тогда
		Лимит = Лимит + 1; // Дополнительная строка — признак обрезанной выдачи.
	КонецЕсли;
	ЕстьПервые = Ложь;
	ЕстьРазрешенные = Ложь;
	Пока Индекс < Токены.Количество() Цикл
		Токен = Токены[Индекс];
		Если Токен.text = "РАЗРЕШЕННЫЕ" Или Токен.text = "ALLOWED" Тогда
			Если ЕстьРазрешенные Тогда
				ВызватьИсключение "ИИ: повторное РАЗРЕШЕННЫЕ.";
			КонецЕсли;
			ЕстьРазрешенные = Истина;
		ИначеЕсли Токен.text = "РАЗЛИЧНЫЕ" Или Токен.text = "DISTINCT" Тогда
			Если Различные Тогда
				ВызватьИсключение "ИИ: повторное РАЗЛИЧНЫЕ.";
			КонецЕсли;
			Различные = Истина;
		ИначеЕсли Токен.text = "ПЕРВЫЕ" Или Токен.text = "TOP" Тогда
			Если ЕстьПервые Или Индекс + 1 >= Токены.Количество() Тогда
				ВызватьИсключение "ИИ: некорректное ПЕРВЫЕ.";
			КонецЕсли;
			Индекс = Индекс + 1;
			Если Токены[Индекс].kind <> "number" Тогда
				ВызватьИсключение "ИИ: ПЕРВЫЕ требует положительного целого литерала.";
			КонецЕсли;
			Количество = Число(Токены[Индекс].text);
			ПроверитьЦелое(Количество, 1, 1000000000, "ПЕРВЫЕ");
			Лимит = Мин(Лимит, Количество);
			ЕстьПервые = Истина;
		Иначе
			Прервать;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Если Индекс >= Токены.Количество() Тогда
		ВызватьИсключение "ИИ: в запросе отсутствуют поля.";
	КонецЕсли;
	Заголовок = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ";
	Если Различные Тогда
		Заголовок = Заголовок + "РАЗЛИЧНЫЕ ";
	КонецЕсли;
	Возврат Заголовок + "ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0;ЧДЦ=0") + " "
		+ Сред(ТекстЗапроса, Токены[Индекс].start);
КонецФункции

// Лексер учитывает строки с удвоенными кавычками и // комментарии.
// Поэтому символы ; и ключевые слова внутри литералов не запрещаются.
Функция ТокеныЗапроса(Текст)
	Результат = Новый Массив;
	Позиция = 1;
	Длина = СтрДлина(Текст);
	Буквы = "ABCDEFGHIJKLMNOPQRSTUVWXYZАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ_";
	Цифры = "0123456789";
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = " " Или Символ = Символы.Таб Или Символ = Символы.ПС Или Символ = Символы.ВК Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Если Сред(Текст, Позиция, 2) = "//" Тогда
			Пока Позиция <= Длина И Сред(Текст, Позиция, 1) <> Символы.ПС И Сред(Текст, Позиция, 1) <> Символы.ВК Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		Начало = Позиция;
		Вид = "symbol";
		Если Символ = """" Тогда
			Вид = "string";
			Позиция = Позиция + 1;
			Закрыта = Ложь;
			Пока Позиция <= Длина Цикл
				Если Сред(Текст, Позиция, 1) = """" Тогда
					Если Сред(Текст, Позиция + 1, 1) = """" Тогда
						Позиция = Позиция + 2;
						Продолжить;
					КонецЕсли;
					Позиция = Позиция + 1;
					Закрыта = Истина;
					Прервать;
				КонецЕсли;
				Позиция = Позиция + 1;
			КонецЦикла;
			Если Не Закрыта Тогда
				ВызватьИсключение "ИИ: незакрытая строка в запросе.";
			КонецЕсли;
		ИначеЕсли СтрНайти(Буквы, ВРег(Символ)) > 0 Тогда
			Вид = "word";
			Позиция = Позиция + 1;
			Пока Позиция <= Длина Цикл
				Символ = ВРег(Сред(Текст, Позиция, 1));
				Если СтрНайти(Буквы + Цифры, Символ) = 0 Тогда
					Прервать;
				КонецЕсли;
				Позиция = Позиция + 1;
			КонецЦикла;
		ИначеЕсли СтрНайти(Цифры, Символ) > 0 Тогда
			Вид = "number";
			Позиция = Позиция + 1;
			Пока Позиция <= Длина И СтрНайти(Цифры, Сред(Текст, Позиция, 1)) > 0 Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
		Иначе
			Позиция = Позиция + 1;
		КонецЕсли;
		Результат.Добавить(Новый Структура("text,start,kind", ВРег(Сред(Текст, Начало, Позиция - Начало)), Начало, Вид));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПараметрыИСериализация

Функция ПреобразоватьПараметры(Параметры) Экспорт
	Результат = Новый Соответствие;
	Имена = Новый Соответствие;
	Если Параметры = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Параметры) <> Тип("Массив") Тогда
		ВызватьИсключение "ИИ: параметры должны быть массивом.";
	КонецЕсли;
	Если Параметры.Количество() > 30 Тогда
		ВызватьИсключение "ИИ: слишком много параметров запроса.";
	КонецЕсли;
	Для Каждого Параметр Из Параметры Цикл
		Имя = ПолеJSON(Параметр, "name", "");
		ПроверитьСтроку(Имя, 100, "Имя параметра");
		Если ПустаяСтрока(Имя) Тогда
			ВызватьИсключение "ИИ: пустое имя параметра.";
		КонецЕсли;
		ТокеныИмени = ТокеныЗапроса(Имя);
		Если ТокеныИмени.Количество() <> 1 Тогда
			ВызватьИсключение "ИИ: некорректное имя параметра.";
		КонецЕсли;
		Если ТокеныИмени[0].kind <> "word" Или ТокеныИмени[0].start <> 1
			Или СтрДлина(ТокеныИмени[0].text) <> СтрДлина(Имя) Тогда
			ВызватьИсключение "ИИ: некорректное имя параметра.";
		КонецЕсли;
		Если Имена.Получить(ВРег(Имя)) <> Неопределено Тогда
			ВызватьИсключение "ИИ: повторное имя параметра.";
		КонецЕсли;
		Вид = ПолеJSON(Параметр, "type", "");
		Значение = ПолеJSON(Параметр, "value");
		Если Вид = "date" Тогда
			Значение = ДатаИзISO(Значение);
		ИначеЕсли Вид = "string" Тогда
			ПроверитьСтроку(Значение, 2000, "Значение параметра");
		ИначеЕсли Вид = "number" Тогда
			Если ТипЗнч(Значение) <> Тип("Число") Тогда
				ВызватьИсключение "ИИ: ожидается числовой параметр.";
			КонецЕсли;
		ИначеЕсли Вид = "boolean" Тогда
			Если ТипЗнч(Значение) <> Тип("Булево") Тогда
				ВызватьИсключение "ИИ: ожидается булев параметр.";
			КонецЕсли;
		Иначе
			ВызватьИсключение "ИИ: поддержаны параметры string, number, boolean, date.";
		КонецЕсли;
		Имена.Вставить(ВРег(Имя), Истина);
		Результат.Вставить(Имя, Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДатаИзISO(Текст) Экспорт
	ПроверитьСтроку(Текст, 19, "Дата");
	Длина = СтрДлина(Текст);
	Если (Длина <> 10 И Длина <> 19) Или Сред(Текст, 5, 1) <> "-" Или Сред(Текст, 8, 1) <> "-" Тогда
		ВызватьИсключение "ИИ: дата должна иметь вид YYYY-MM-DD или YYYY-MM-DDTHH:MM:SS.";
	КонецЕсли;
	Если Длина = 19 Тогда
		Если Сред(Текст, 11, 1) <> "T" Или Сред(Текст, 14, 1) <> ":" Или Сред(Текст, 17, 1) <> ":" Тогда
			ВызватьИсключение "ИИ: некорректное время ISO.";
		КонецЕсли;
	КонецЕсли;
	Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, "-", ""), "T", ""), ":", "");
	Для Индекс = 1 По СтрДлина(Цифры) Цикл
		Если СтрНайти("0123456789", Сред(Цифры, Индекс, 1)) = 0 Тогда
			ВызватьИсключение "ИИ: некорректная дата ISO.";
		КонецЕсли;
	КонецЦикла;
	Если Длина = 10 Тогда
		Цифры = Цифры + "000000";
	КонецЕсли;
	Попытка
		Значение = Дата(Цифры);
		Если Формат(Значение, "ДФ=yyyyMMddHHmmss") <> Цифры Тогда
			ВызватьИсключение "ИИ: несуществующая календарная дата.";
		КонецЕсли;
		Возврат Значение;
	Исключение
		ВызватьИсключение "ИИ: несуществующая календарная дата.";
	КонецПопытки;
КонецФункции

Функция ЗначениеДляJSON(Значение)
	Вид = ТипЗнч(Значение);
	Если Вид = Тип("Неопределено") Или Вид = Тип("Null") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Вид = Тип("Число") Или Вид = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли Вид = Тип("Дата") Тогда
		Возврат Новый Структура("type,value", "date", Формат(Значение, "ДФ=yyyy-MM-dd") + "T" + Формат(Значение, "ДФ=HH:mm:ss"));
	ИначеЕсли Вид = Тип("Строка") Тогда
		Если СтрДлина(Значение) > 1000 Тогда
			Возврат Новый Структура("type,value,truncated", "string", Лев(Значение, 1000), Истина);
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	ОбъектМД = Метаданные.НайтиПоТипу(Вид);
	Если ОбъектМД <> Неопределено Тогда
		Возврат Новый Структура("type,object,presentation", "reference", ОбъектМД.ПолноеИмя(), Лев(Строка(Значение), 1000));
	КонецЕсли;
	Возврат Новый Структура("type,presentation", Строка(Вид), Лев(Строка(Значение), 1000));
КонецФункции

Функция JSON(Данные) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция ПолеJSON(Объект, Имя, ПоУмолчанию = Неопределено) Экспорт
	Значение = Неопределено;
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Если Объект.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Процедура ПроверитьКонтекст()
	Если ПривилегированныйРежим() Тогда
		ВызватьИсключение "ИИ: получение контекста и фактов запрещено в привилегированном режиме.";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСтроку(Значение, Максимум, Имя)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение "ИИ: требуется строка " + Имя + ".";
	КонецЕсли;
	Если СтрДлина(Значение) > Максимум Тогда
		ВызватьИсключение "ИИ: превышена длина " + Имя + ".";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЦелое(Значение, Минимум, Максимум, Имя)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение "ИИ: требуется число " + Имя + ".";
	КонецЕсли;
	Если Значение < Минимум Или Значение > Максимум Или Цел(Значение) <> Значение Тогда
		ВызватьИсключение "ИИ: недопустимое значение " + Имя + ".";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
