// Для выполнения объедините Module.bsl и этот файл в отдельном серверном
// общем модуле ИнтеграцияИИТесты. Тесты вызывают внутренние функции копии.
// В рабочий модуль тесты не добавляются. Сеть и ключи не нужны.

Функция ВыполнитьОфлайнТесты() Экспорт
	Настройки = НовыеНастройки("Яндекс");
	Настройки.КаталогЯндекс = "test-folder";
	Настройки.КлючAPI = "test-key";
	Сообщения = Новый Массив;
	Сообщения.Добавить(НовоеСообщение("system", "Первая инструкция"));
	Сообщения.Добавить(НовоеСообщение("system", "Вторая инструкция"));
	Сообщения.Добавить(НовоеСообщение("user", "Привет"));
	Сообщения.Добавить(НовоеСообщение("assistant", "Здравствуйте"));
	Сообщения.Добавить(НовоеСообщение("user", "Продолжим"));
	ПроверитьНастройки(Настройки);
	ПроверитьСообщения(Сообщения);
	Тело = ТелоЗапросаЯндекс(Настройки, Сообщения);
	ПроверитьРавенство(Тело.model, "gpt://test-folder/yandexgpt-5.1/latest", "URI Яндекс");
	ПроверитьРавенство(Тело.instructions, "Первая инструкция" + Символы.ПС + "Вторая инструкция", "Инструкции");
	ПроверитьРавенство(Тело.input.Количество(), 3, "История без system");
	ПроверитьРавенство(Тело.input[1].role, "assistant", "Порядок истории");
	ПроверитьРавенство(Тело.max_output_tokens, 1500, "Лимит Responses API");
	Настройки.Модель = "gpt://test-folder/aliceai-llm/latest";
	ПроверитьРавенство(ТелоЗапросаЯндекс(Настройки, Сообщения).model, Настройки.Модель, "Полный URI");
	ТекстJSON = СтрокаJSON(Тело);
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Копия = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	ПроверитьРавенство(Копия.input[0].content, "Привет", "JSON кириллица");

	Чат = НовыеНастройки("GigaChat");
	Чат.ТокенДоступа = "test-token";
	Чат.СрокДействияТокена = МиллисекундыUnix() + 3600000;
	ПроверитьРавенство(ПолучитьТокенGigaChat(Чат), "test-token", "Кэш OAuth без сети");
	Чат.СрокДействияТокена = 0;
	ПроверитьРавенство(ПолучитьТокенGigaChat(Чат), "test-token", "Внешний токен без срока");
	ТелоЧата = ТелоЗапросаЧата(Чат, Сообщения);
	ПроверитьРавенство(ТелоЧата.profanity_check, Истина, "Проверка лексики");
	ПроверитьРавенство(ТелоЧата.max_tokens, 1500, "Лимит чата");
	Для Каждого Провайдер Из СтрРазделить("OpenRouter,VseGPT,BotHub,OpenAI", ",") Цикл
		ТелоЧата = ТелоЗапросаЧата(НовыеНастройки(Провайдер), Сообщения);
		Если ТелоЧата.Свойство("profanity_check") Тогда
			ВызватьИсключение "Тест: параметр GigaChat попал к другому провайдеру.";
		КонецЕсли;
	КонецЦикла;

	Адрес = РазобратьURL("https://ngw.devices.sberbank.ru:9443/api/v2/oauth");
	ПроверитьРавенство(Адрес.Порт, 9443, "Порт OAuth");
	ПроверитьРавенство(Адрес.Путь, "/api/v2/oauth", "Путь OAuth");
	ПроверитьРавенство(РазобратьURL("https://api.giga.chat/v1/models").Порт, 443, "Порт HTTPS");

	Выход = Новый Массив;
	Содержимое = Новый Массив;
	Содержимое.Добавить(Новый Структура("type,text", "output_text", "Привет"));
	Содержимое.Добавить(Новый Структура("type,text", "output_text", "!"));
	Выход.Добавить(Новый Структура("type", "reasoning"));
	Выход.Добавить(Новый Структура("type,content", "message", Содержимое));
	Ответ = Новый Структура("status,output", "completed", Выход);
	ПроверитьРавенство(ТекстОтветаЯндекс(Ответ), "Привет!", "Responses REST блоки");
	ПроверитьРавенство(ТекстОтветаЯндекс(Новый Структура("output_text", "Ответ")), "Ответ", "output_text");
	Варианты = Новый Массив;
	Варианты.Добавить(Новый Структура("message", Новый Структура("content", "Ответ чата")));
	ПроверитьРавенство(ТекстОтветаЧата(Новый Структура("choices", Варианты)), "Ответ чата", "Chat REST");

	// Негативные сценарии должны завершиться именно ожидаемым исключением.
	ПроверитьОжидаемуюОшибку("HTTP", "разрешен только HTTPS");
	ПроверитьОжидаемуюОшибку("ПустойChoices", "пустой choices");
	ПроверитьОжидаемуюОшибку("ПустойЗапрос", "непустой запрос пользователя");
	ПроверитьОжидаемуюОшибку("Роль", "допустимые роли");
	ПроверитьОжидаемуюОшибку("ИстекшийТокен", "не заполнено КлючАвторизации");
	ПроверитьОжидаемуюОшибку("ПереносВКлюче", "недопустимый перенос строки");
	ПроверитьОжидаемуюОшибку("СтатусОтвета", "не завершена успешно");
	Возврат "Офлайн-тесты пройдены.";
КонецФункции

Процедура ПроверитьРавенство(Фактически, Ожидается, Название)
	Если Фактически <> Ожидается Тогда
		ВызватьИсключение "Тест не пройден: " + Название;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОжидаемуюОшибку(Сценарий, Фрагмент)
	ОшибкаПолучена = Ложь;
	Попытка
		Если Сценарий = "HTTP" Тогда
			РазобратьURL("http://example.com/v1");
		ИначеЕсли Сценарий = "ПустойChoices" Тогда
			ТекстОтветаЧата(Новый Структура("choices", Новый Массив));
		ИначеЕсли Сценарий = "ПустойЗапрос" Тогда
			Сообщения = Новый Массив;
			Сообщения.Добавить(НовоеСообщение("user", ""));
			ПроверитьСообщения(Сообщения);
		ИначеЕсли Сценарий = "Роль" Тогда
			НовоеСообщение("tool", "Текст");
		ИначеЕсли Сценарий = "ИстекшийТокен" Тогда
			Настройки = НовыеНастройки("GigaChat");
			Настройки.ТокенДоступа = "expired";
			Настройки.СрокДействияТокена = 1;
			ПолучитьТокенGigaChat(Настройки);
		ИначеЕсли Сценарий = "ПереносВКлюче" Тогда
			ТребоватьСтроку("test" + Символы.ПС + "injection", "КлючAPI");
		ИначеЕсли Сценарий = "СтатусОтвета" Тогда
			ТекстОтветаЯндекс(Новый Структура("status,output_text", "failed", "Частичный ответ"));
		КонецЕсли;
	Исключение
		Если СтрНайти(ОписаниеОшибки(), Фрагмент) = 0 Тогда
			ВызватьИсключение;
		КонецЕсли;
		ОшибкаПолучена = Истина;
	КонецПопытки;
	Если Не ОшибкаПолучена Тогда
		ВызватьИсключение "Тест: не получена ожидаемая ошибка " + Сценарий;
	КонецЕсли;
КонецПроцедуры
