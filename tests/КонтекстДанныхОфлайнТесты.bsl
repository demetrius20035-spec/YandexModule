// Объедините КонтекстДанныхИИ/Ext/Module.bsl и этот файл в отдельном
// непривилегированном серверном общем модуле КонтекстДанныхИИТесты.
// Эти тесты не обращаются к базе данных, метаданным или сети.

Функция ВыполнитьТестыКонтекста() Экспорт
	Равно(ПодготовитьЗапрос("ВЫБРАТЬ 1 КАК Число", 10),
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 11 1 КАК Число", "Лимит до выполнения");
	Равно(ПодготовитьЗапрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 5 Поле ИЗ Источник", 10),
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 5 Поле ИЗ Источник", "Сохранение меньшего лимита");
	Равно(ПодготовитьЗапрос("SELECT TOP 100000 Field FROM Source", 10),
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 11 Field FROM Source", "Ограничение английского TOP");
	Равно(ПодготовитьЗапрос("ВЫБРАТЬ 1 КАК Число", 10, Ложь),
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 10 1 КАК Число", "Лимит СКД без запасной строки");
	Исходный = "// ПОМЕСТИТЬ;" + Символы.ПС
		+ "ВЫБРАТЬ ""Текст; ПОМЕСТИТЬ """"кавычки"""""" КАК Текст // UNION;";
	Подготовленный = ПодготовитьЗапрос(Исходный, 10);
	Если СтрНайти(Подготовленный, "ПЕРВЫЕ 11") = 0 Тогда
		ВызватьИсключение "Тест: не применен лимит к запросу с комментариями.";
	КонецЕсли;
	Токены = ТокеныЗапроса(Исходный);
	Равно(Токены.Количество(), 4, "Литерал и комментарии не становятся командами");
	Равно(Токены[1].kind, "string", "Удвоенные кавычки");

	Параметры = Новый Массив;
	Параметры.Добавить(Новый Структура("name,type,value", "Город", "string", "Казань"));
	Параметры.Добавить(Новый Структура("name,type,value", "Количество", "number", 5));
	Параметры.Добавить(Новый Структура("name,type,value", "Проведен", "boolean", Истина));
	Параметры.Добавить(Новый Структура("name,type,value", "Начало", "date", "2026-03-01"));
	Значения = ПреобразоватьПараметры(Параметры);
	Равно(Значения.Получить("Город"), "Казань", "Строковый параметр");
	Равно(Значения.Получить("Количество"), 5, "Числовой параметр");
	Равно(Значения.Получить("Проведен"), Истина, "Булев параметр");
	Равно(Значения.Получить("Начало"), Дата(2026, 3, 1), "Дата без времени");
	Равно(ДатаИзISO("2026-03-31T23:59:59"), Дата(2026, 3, 31, 23, 59, 59), "Дата со временем");
	Равно(ЗначениеДляJSON(Null), Неопределено, "JSON null");
	Равно(ЗначениеДляJSON(Дата(2026, 3, 1)).value, "2026-03-01T00:00:00", "Сериализация даты");
	Равно(ЗначениеДляJSON("Казань"), "Казань", "Сериализация строки");

	ОжидатьОтказЗапроса("ВЫБРАТЬ 1; ВЫБРАТЬ 2");
	ОжидатьОтказЗапроса("ВЫБРАТЬ 1 ПОМЕСТИТЬ Временная");
	ОжидатьОтказЗапроса("SELECT 1 INTO Temp");
	ОжидатьОтказЗапроса("ВЫБРАТЬ 1 ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ 2");
	ОжидатьОтказЗапроса("ВЫБРАТЬ Поле ИЗ Источник ДЛЯ ИЗМЕНЕНИЯ");
	ОжидатьОтказЗапроса("SELECT Field FROM Source FOR UPDATE");
	ОжидатьОтказЗапроса("ВЫБРАТЬ 1 ИТОГИ СУММА(1) ПО ОБЩИЕ");
	ОжидатьОтказЗапроса("ВЫБРАТЬ ""Незакрытая строка");
	ОжидатьОтказЗапроса("ВЫБРАТЬ ПЕРВЫЕ &Лимит 1");
	ОжидатьОтказЗапроса("ВЫБРАТЬ ПЕРВЫЕ 0 1");
	ОжидатьОтказЗапроса("ВЫБРАТЬ ПЕРВЫЕ 1 ПЕРВЫЕ 2 1");
	ОжидатьОтказЗапроса("УНИЧТОЖИТЬ Временная");
	ОжидатьОтказЗапроса("ВЫБРАТЬ");
	ОжидатьОтказПараметров("Город", "string", 123);
	ОжидатьОтказПараметров("Город;Запрос", "string", "Казань");
	ОжидатьОтказПараметров("Город", "reference", "Произвольный объект");
	ОжидатьОтказПараметров("Начало", "date", "2026-02-30");
	ОжидатьОтказПараметров("Начало", "date", "2026-03-01T00:00:00Z");
	Параметры = Новый Массив;
	Параметры.Добавить(Новый Структура("name,type,value", "Город", "string", "Казань"));
	Параметры.Добавить(Новый Структура("name,type,value", "город", "string", "Москва"));
	Ошибка = Ложь;
	Попытка
		ПреобразоватьПараметры(Параметры);
	Исключение
		Если СтрНайти(ОписаниеОшибки(), "повторное имя") = 0 Тогда
			ВызватьИсключение;
		КонецЕсли;
		Ошибка = Истина;
	КонецПопытки;
	Равно(Ошибка, Истина, "Имена параметров без учета регистра");
	Возврат "Тесты контекста пройдены.";
КонецФункции

Процедура Равно(Фактически, Ожидается, Имя)
	Если Фактически <> Ожидается Тогда
		ВызватьИсключение "Тест не пройден: " + Имя;
	КонецЕсли;
КонецПроцедуры

Процедура ОжидатьОтказЗапроса(Текст)
	Ошибка = Ложь;
	Попытка
		ПодготовитьЗапрос(Текст, 10);
	Исключение
		Если СтрНайти(ОписаниеОшибки(), "ИИ:") = 0 Тогда
			ВызватьИсключение;
		КонецЕсли;
		Ошибка = Истина;
	КонецПопытки;
	Равно(Ошибка, Истина, "Отклонение неподдерживаемого запроса");
КонецПроцедуры

Процедура ОжидатьОтказПараметров(Имя, Вид, Значение)
	Параметры = Новый Массив;
	Параметры.Добавить(Новый Структура("name,type,value", Имя, Вид, Значение));
	Ошибка = Ложь;
	Попытка
		ПреобразоватьПараметры(Параметры);
	Исключение
		Если СтрНайти(ОписаниеОшибки(), "ИИ:") = 0 Тогда
			ВызватьИсключение;
		КонецЕсли;
		Ошибка = Истина;
	КонецПопытки;
	Равно(Ошибка, Истина, "Отклонение некорректного параметра");
КонецПроцедуры
